/android/app/debug
/android/app/profile
/android/app/release

# Local Netlify folder
.netlify

# Backend server
# A service_role key that reaches a public repo cannot be un-published, only rotated.
.env
.env.*
server/node_modules/
server/data/
server/uploads/

# Static site CSS build tooling (ui/assets/css/oak-tailwind.css is committed)
tools/tailwind/node_modules/
# Leftover from when the tooling lived in ui/ — must never be committed (ui/ is served publicly)
ui/node_modules/
